# ==============================================================================
# TerraID 3D — Geospatial API Environment Configuration (Example)
# ==============================================================================

# Copernicus Data Space Ecosystem API Credentials
# Used for authenticated full scene & high-res band downloads (free registration at dataspace.copernicus.eu)
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# Bhuvan (NRSC / ISRO) API Token
# Used for authenticated Indian spatial data services (bhuvan.nrsc.gov.in)
BHUVAN_API_TOKEN=your_bhuvan_api_token_here

# Cesium Ion Default Access Token (Optional - open ESRI/OSM basemap is used by default)
CESIUM_ION_ACCESS_TOKEN=your_cesium_ion_token_here
